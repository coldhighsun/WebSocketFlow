<Project>
  <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <UseArtifactsOutput>true</UseArtifactsOutput>
      <DebugType>embedded</DebugType>
      <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
